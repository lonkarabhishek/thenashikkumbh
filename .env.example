# Copy to .env.local for local development. See docs/AI-SETUP.md.

# Anthropic API key for the Kumbh Sahayak assistant. Without it the chat
# uses the built-in keyword engine.
ANTHROPIC_API_KEY=

# Daily spend cap in dollars (0.075 a day is about 200 rupees a month).
AI_DAILY_CAP_USD=0.075
AI_VISITOR_DAY_CAP=25
AI_VISITOR_MINUTE_CAP=5
AI_VISITOR_SALT=

# Optional shared counters (supabase/migrations/20261009_kumbh_ai_limits.sql).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
